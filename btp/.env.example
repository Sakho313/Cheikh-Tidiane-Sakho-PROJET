# Variables d'environnement — à définir dans Vercel
# (Project → Settings → Environment Variables). Tant qu'elles sont absentes,
# le formulaire bascule automatiquement sur WhatsApp / email.

# ── Formulaire de devis — Mailtrap ────────────────────────────────────────────
# Jeton d'API : Mailtrap → Sending Domains (ou Email Testing) → API Tokens.
MAILTRAP_TOKEN=
# Destinataire des demandes (boîte professionnelle SAO).
CONTACT_TO=contact@saoconsultingroup.com
# Expéditeur : doit appartenir à un domaine VÉRIFIÉ dans Mailtrap.
MAILTRAP_FROM=noreply@saoconsultingroup.com
# MODE TEST : ID d'une boîte « Email Testing » pour capturer les emails sans
# rien envoyer réellement. Laisser VIDE en production.
MAILTRAP_INBOX_ID=
