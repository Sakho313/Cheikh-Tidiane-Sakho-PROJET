---
import '../styles/tokens.css';
import '../styles/global.css';
import site from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.nom} — ${site.baseline} | ${site.groupe}`,
  description = "SAO BTP · Immobilier · Topographie : terrains sécurisés, gestion locative pour la diaspora, levé par drone, bornage, travaux publics, villa clé en main et sécurisation foncière (DSCOS, Domaines) à Dakar.",
} = Astro.props;

const canonical = site.domaine + '/';

/* JSON-LD — SPEC §7 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': canonical + '#btp',
      name: site.nom,
      slogan: site.baseline,
      description,
      url: canonical,
      email: site.email,
      telephone: site.telSN,
      areaServed: ['SN', 'FR'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Keur Massar',
        addressRegion: 'Dakar',
        addressCountry: 'SN',
      },
      parentOrganization: { '@type': 'Organization', name: site.groupe, url: site.siteGroupe },
    },
    {
      '@type': 'RealEstateAgent',
      '@id': canonical + '#gestion',
      name: site.nom + ' — Immobilier & gestion locative',
      url: canonical + '#gestion',
      email: site.email,
      telephone: site.telSN,
      areaServed: ['SN', 'FR'],
    },
    ...site.services.map((s: { nom: string; desc: string; ancre: string }) => ({
      '@type': 'Service',
      name: s.nom,
      description: s.desc,
      url: canonical + s.ancre,
      provider: { '@id': canonical + '#btp' },
      areaServed: 'SN',
    })),
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="immobilier Dakar, terrain sécurisé Sénégal, gestion locative diaspora, bornage lotissement, levé topographique drone, construction villa clé en main Dakar, sécurisation foncière DSCOS" />
    <meta name="theme-color" content="#03393B" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonical + 'brand/og.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body id="top">
    <a class="skip" href="#contenu">Aller au contenu</a>

    <header id="hdr">
      <div class="wrap nav">
        <a class="brand" href="#top" aria-label={`${site.nomCourt}, accueil`}>
          <img src="/brand/logo.png" alt="" width="345" height="420" />
          <span><b>{site.nomCourt}</b><span>Immobilier · Topographie</span></span>
        </a>
        <nav class="menu" id="menu" aria-label="Navigation principale">
          {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a class="btn btn-gold" href="#devis">Devis</a>
        </nav>
        <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer>
      <div class="wrap">
        <div class="fgrid">
          <div class="fbrand">
            <img src="/brand/logo.png" alt="" width="345" height="420" />
            <p>{site.nom} — {site.baseline} Une filiale de {site.groupe}.</p>
            <p class="f-eng mono">{site.engagement}</p>
          </div>
          <div class="fcol">
            <h4>Nos métiers</h4>
            {site.nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
          <div class="fcol">
            <h4>Contact</h4>
            <a href={`https://wa.me/${site.telSNraw}`} target="_blank" rel="noopener">WhatsApp · {site.telSN}</a>
            <a href={`tel:+${site.telFRraw}`}>{site.telFR}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
            <a href="#devis">Demander un devis</a>
          </div>
        </div>
        <div class="fbar">
          <span>© <span id="yr"></span> {site.groupe} — {site.nomCourt}.</span>
          <span>{site.signature} · {site.adresse}</span>
        </div>
      </div>
    </footer>

    <a
      class="fab fab-wa"
      href={`https://wa.me/${site.telSNraw}?text=${encodeURIComponent('Bonjour SAO BTP, je souhaite des informations.')}`}
      target="_blank" rel="noopener" aria-label="Contacter sur WhatsApp"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"
        ><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1z"
      /></svg>
    </a>
    <button class="fab fab-top" id="topFab" type="button" aria-label="Revenir en haut">↑</button>

    <script>
      // En-tête au scroll + bouton retour en haut
      const hdr = document.getElementById('hdr');
      const topFab = document.getElementById('topFab');
      const onScroll = () => {
        const y = window.scrollY;
        hdr?.classList.toggle('scrolled', y > 20);
        topFab?.classList.toggle('on', y > 600);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      topFab?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));

      // Menu mobile
      const burger = document.getElementById('burger');
      const menu = document.getElementById('menu');
      burger?.addEventListener('click', () => {
        const open = menu!.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      });
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.remove('open')));

      // Reveals au scroll
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Visuels optionnels (mascotte SAOTY) : masqués tant que le fichier n'est pas fourni
      document.querySelectorAll<HTMLImageElement>('img[data-optionnel]').forEach((im) => {
        const cacher = () => { im.closest('.saoty-art')?.remove(); im.remove(); };
        if (im.complete && im.naturalWidth === 0) cacher();
        im.addEventListener('error', cacher);
      });

      const yr = document.getElementById('yr');
      if (yr) yr.textContent = String(new Date().getFullYear());
    </script>

    <style>
      header { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: 0.3s; border-bottom: 1px solid transparent; }
      header.scrolled { background: rgb(7 19 17 / 0.86); backdrop-filter: blur(14px); border-color: var(--line); }
      .nav { display: flex; align-items: center; justify-content: space-between; height: 74px; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand img { height: 40px; width: auto; filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.5)); }
      .brand b { font-family: var(--display); font-weight: 800; font-size: 17px; letter-spacing: 0.03em; display: block; line-height: 1; }
      .brand span span { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gray); }
      .menu { display: flex; gap: 24px; align-items: center; }
      .menu a { font-size: 14px; font-weight: 500; color: var(--mist); opacity: 0.85; transition: 0.2s; }
      .menu a:hover { color: var(--aqua2); opacity: 1; }
      .burger { display: none; background: none; border: 0; cursor: pointer; padding: 8px; }
      .burger span { display: block; width: 24px; height: 2px; background: var(--mist); margin: 5px 0; }

      footer { background: #050e0d; border-top: 1px solid var(--line); padding: 56px 0 28px; }
      .fgrid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 32px; }
      .fbrand img { height: 38px; width: auto; margin-bottom: 13px; }
      .fbrand p { color: var(--muted); font-size: 14px; max-width: 40ch; }
      .f-eng { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
      .fcol h4 { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gray); margin: 0 0 15px; }
      .fcol a { display: block; color: var(--muted); font-size: 14px; padding: 5px 0; }
      .fcol a:hover { color: var(--aqua2); }
      .fbar { margin-top: 42px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; color: var(--gray); font-size: 13px; font-family: var(--mono); }

      .fab { position: fixed; right: 18px; z-index: 70; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; border: 0; cursor: pointer; box-shadow: 0 8px 24px rgb(0 0 0 / 0.4); transition: 0.25s; }
      .fab:hover { transform: translateY(-3px); }
      .fab-wa { bottom: 20px; background: #25d366; }
      .fab-top { bottom: 84px; background: var(--panel); border: 1px solid var(--line); color: var(--gold); font-size: 22px; opacity: 0; pointer-events: none; }
      .fab-top.on { opacity: 1; pointer-events: auto; }

      @media (max-width: 1024px) { .menu { gap: 16px; } .menu a { font-size: 13px; } }
      @media (max-width: 960px) {
        .menu {
          display: none; position: absolute; top: 74px; left: 0; right: 0; flex-direction: column;
          align-items: flex-start; background: rgb(7 19 17 / 0.98); backdrop-filter: blur(14px);
          padding: 18px 24px; gap: 6px; border-bottom: 1px solid var(--line);
        }
        .menu.open { display: flex; }
        .menu a { padding: 11px 0; width: 100%; min-height: 40px; }
        .burger { display: block; }
        .fgrid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 560px) { .fgrid { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
