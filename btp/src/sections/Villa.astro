---
import SectionHead from '../components/SectionHead.astro';
import p from '../content/prestations.json';
---
<section class="sec band" id="villa">
  <div class="wrap">
    <SectionHead
      num="06"
      label="Villa clé en main"
      titre="Votre villa, du premier croquis aux clés en main."
      intro="Architecture, conseil et construction : nous concevons et bâtissons votre villa de A à Z, à vos côtés à chaque décision."
    />

    <div class="villa">
      <div class="panel tick villa-visual reveal">
        <div class="cap"><span>Élévation — villa contemporaine</span><b>SAO</b></div>
        <svg class="bpsvg" viewBox="0 0 460 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Élévation d’une villa contemporaine R+1 avec piscine, dessinée progressivement">
          <path class="bp dim" style="animation-delay:.1s" d="M20 256 H440" />
          <path class="bp" style="animation-delay:.3s" d="M56 256 V176 H206 V256" />
          <path class="bp g" style="animation-delay:.5s" d="M48 176 H214" />
          <path class="bp" style="animation-delay:.7s" d="M176 256 V92 H372 V256" />
          <path class="bp g" style="animation-delay:.9s" d="M168 92 H380" />
          <path class="bp g" style="animation-delay:1s" d="M176 150 H372" />
          <path class="bp" style="animation-delay:1.1s" d="M250 256 V210 H286 V256" />
          <path class="bp" style="animation-delay:1.15s" d="M80 256 V206 H150 V256" />
          <g>
            <rect class="win" style="animation-delay:1.5s" x="196" y="104" width="30" height="36" />
            <rect class="win" style="animation-delay:1.6s" x="232" y="104" width="30" height="36" />
            <rect class="win" style="animation-delay:1.7s" x="300" y="104" width="30" height="36" />
            <rect class="win" style="animation-delay:1.8s" x="336" y="104" width="30" height="36" />
            <rect class="win" style="animation-delay:1.7s" x="196" y="164" width="60" height="34" />
            <rect class="win" style="animation-delay:1.9s" x="300" y="164" width="66" height="34" />
            <rect class="win" style="animation-delay:1.6s" x="86" y="184" width="26" height="16" />
          </g>
          <path class="bp" style="animation-delay:1.9s;stroke:rgb(40 182 230 / .5)" d="M300 268 h108 a6 6 0 0 1 6 6 v6 a6 6 0 0 1-6 6 h-108 a6 6 0 0 1-6-6 v-6 a6 6 0 0 1 6-6 z" />
          <path class="bp dim" style="animation-delay:2.1s" d="M312 280 H402" />
          <path class="bp g" style="animation-delay:1.3s" d="M424 256 V196 M424 196 q-16-10-26-4 M424 196 q16-10 26-4 M424 196 q-10-16-2-24 M424 196 q10-16 2-24" />
          <path class="bp dim" style="animation-delay:1.4s" d="M40 92 V256 M36 92 H44 M36 256 H44" />
          <text class="lbl" x="150" y="292">VILLA CONTEMPORAINE · R+1 · CLÉ EN MAIN</text>
          <text class="lbl" x="20" y="176" transform="rotate(-90 20 176)">R+1</text>
        </svg>
      </div>

      <ol class="vtimeline reveal">
        {p.villaEtapes.map((e) => (
          <li class="vstep">
            <span class="vdot" aria-hidden="true">{e.n}</span>
            <div><b>{e.titre}</b><span>{e.desc}</span></div>
          </li>
        ))}
      </ol>
    </div>

    <div class="advice">
      {p.villaConseil.map((c) => (
        <div class="panel tick acard reveal">
          <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.icone} /></svg></div>
          <b>{c.titre}</b><span>{c.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .vtimeline { list-style: none; padding: 0; margin: 0; }
</style>
