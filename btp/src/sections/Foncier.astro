---
import SectionHead from '../components/SectionHead.astro';
import p from '../content/prestations.json';
---
<section class="sec" id="foncier">
  <div class="wrap">
    <SectionHead
      num="04"
      label="Bornage & lotissement"
      titre="Sécuriser juridiquement et techniquement vos terrains."
      intro="Avant toute exploitation, nous mettons vos parcelles en conformité."
    />
    <div class="grid4">
      {p.foncier.map((c) => (
        <div class="panel tick card reveal">
          <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={c.icone} /></svg></div>
          <h3>{c.titre}</h3>
          <p>{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
