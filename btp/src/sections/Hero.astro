---
import site from '../content/site.json';
---
<section class="hero">
  <div class="bpgrid"></div>
  <div class="aurora a1"></div>
  <div class="aurora a2"></div>

  <div class="wrap hero-grid">
    <div class="reveal in">
      <span class="tag"><i></i> BTP · Immobilier · Topographie · Dakar</span>
      <h1>Du terrain sécurisé<span class="g">à l’ouvrage livré.</span></h1>
      <p class="lead">
        Nous sécurisons votre foncier, étudions votre terrain et réalisons vos travaux —
        avec un engagement simple : <b>zéro litige, transparence totale</b>.
      </p>
      <div class="hero-cta">
        <a class="btn btn-gold" href="#devis">
          Demander un devis
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn-ghost" href="#immobilier">Nos services</a>
      </div>
      <div class="hero-foot">
        <span>Vérification <b>foncière</b></span>
        <span>Levé <b>par drone</b></span>
        <span>Terrassement <b>&amp; travaux</b></span>
      </div>
    </div>

    <div class="panel tick blueprint reveal in">
      <div class="cap"><span>Plan — parcelle &amp; ouvrage</span><b>SAO</b></div>
      <svg class="bpsvg" viewBox="0 0 460 300" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Plan d’une parcelle bornée et d’un bâtiment, dessiné progressivement">
        <path class="bp dim" style="animation-delay:.1s" d="M20 262 H440" />
        <path class="bp g" style="animation-delay:.2s" d="M40 250 H300 V96 H40 Z" />
        <path class="bp" style="animation-delay:.6s" d="M150 250 V150 H300" />
        <path class="bp" style="animation-delay:.9s" d="M150 150 V96" />
        <path class="bp" style="animation-delay:1.1s" d="M356 250 V96 H430 V250 Z M356 200 H430 M356 150 H430" />
        <g>
          <rect class="win" style="animation-delay:1.5s" x="372" y="160" width="18" height="16" />
          <rect class="win" style="animation-delay:1.6s" x="398" y="160" width="18" height="16" />
          <rect class="win" style="animation-delay:1.7s" x="372" y="210" width="18" height="16" />
          <rect class="win" style="animation-delay:1.8s" x="398" y="210" width="18" height="16" />
        </g>
        <path class="bp dim" style="animation-delay:1.3s" d="M40 278 H300 M40 274 V282 M300 274 V282" />
        <circle class="bp g" style="animation-delay:1.4s" cx="40" cy="96" r="4" />
        <circle class="bp g" style="animation-delay:1.5s" cx="300" cy="96" r="4" />
        <circle class="bp g" style="animation-delay:1.6s" cx="300" cy="250" r="4" />
        <circle class="bp g" style="animation-delay:1.7s" cx="40" cy="250" r="4" />
        <text class="lbl" x="150" y="292">PARCELLE BORNÉE · TF VÉRIFIÉ</text>
        <text class="lbl" x="356" y="90">R+3</text>
      </svg>
    </div>

    <img class="hero-guardian" src="/brand/saoty2.png" data-optionnel alt="SAOTY, la mascotte gardienne de SAO" width="150" height="150" />
  </div>
</section>

<style>
  .hero { position: relative; padding: 130px 0 80px; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(820px 540px at 82% 24%, rgb(7 130 173 / 0.18), transparent 60%),
      radial-gradient(560px 420px at 4% 88%, rgb(233 199 53 / 0.05), transparent 60%),
      linear-gradient(180deg, var(--ink), var(--obsidian));
  }
  .hero-grid { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 44px; align-items: center; position: relative; }
  .tag {
    display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
    border: 1px solid var(--line); background: rgb(233 199 53 / 0.05);
    border-radius: 999px; padding: 6px 13px; margin-bottom: 22px;
  }
  .tag i { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 10px var(--gold); }
  .hero h1 { font-size: clamp(38px, 5.6vw, 68px); font-weight: 900; letter-spacing: -0.03em; }
  .hero h1 .g { display: block; color: var(--gold); text-shadow: 0 0 44px rgb(233 199 53 / 0.28); }
  .hero .lead { margin: 24px 0 32px; }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero-foot { margin-top: 30px; display: flex; gap: 24px; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; color: var(--gray); }
  .hero-foot b { color: var(--gold); }
  .hero-guardian {
    position: absolute; top: -70px; right: -14px; height: 150px; width: auto; z-index: 6;
    pointer-events: none; filter: drop-shadow(0 16px 24px rgb(9 132 227 / 0.35));
    animation: floaty 5s ease-in-out infinite;
  }
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-guardian { display: none; }
    .hero { padding: 108px 0 64px; }
  }
</style>
