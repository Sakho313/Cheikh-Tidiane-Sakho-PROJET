---
import SectionHead from '../components/SectionHead.astro';
import data from '../content/formules.json';

const { formules, criteres, options, parcours } = data;
---
<section class="sec band" id="gestion">
  <div class="wrap">
    <SectionHead
      num="02"
      label="Gestion immobilière premium"
      titre="Votre bien géré au Sénégal, où que vous soyez."
      intro="Pensée pour la diaspora : nous gérons votre bien comme si vous étiez sur place — locataire, loyers, entretien, reporting."
    />

    <!-- Les trois formules -->
    <div class="grid3 formules">
      {formules.map((f) => (
        <div class:list={['panel', 'tick', 'card', 'fml', 'reveal', { pop: f.populaire }]}>
          {f.populaire && <span class="pop-tag mono">Le plus choisi</span>}
          <h3>{f.nom}</h3>
          <p class="acc">{f.accroche}</p>
          <p class="prix mono">{f.tarif ?? f.tarifNote}</p>
          <ul class="checklist">
            {f.inclus.map((i) => (
              <li><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>{i}</li>
            ))}
          </ul>
          <a class:list={['btn', f.populaire ? 'btn-gold' : 'btn-ghost', 'fml-cta']} href="#devis">Choisir {f.nom}</a>
        </div>
      ))}
    </div>

    <!-- Tableau comparatif -->
    <div class="panel tick tablewrap reveal">
      <div class="tw-head mono">Comparatif des formules</div>
      <div class="tscroll">
        <table>
          <caption class="sr-only">Comparaison des prestations incluses dans chaque formule de gestion locative</caption>
          <thead>
            <tr>
              <th scope="col">Prestation</th>
              {formules.map((f) => <th scope="col">{f.nom}</th>)}
            </tr>
          </thead>
          <tbody>
            {criteres.map((c) => (
              <tr>
                <th scope="row">{c.label}</th>
                {(['essentiel', 'serenite', 'gold'] as const).map((k) => (
                  <td>
                    {c[k] ? (
                      <><span class="sr-only">Inclus</span><svg class="yes" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg></>
                    ) : (
                      <><span class="sr-only">Non inclus</span><span class="no" aria-hidden="true">—</span></>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Configurateur + estimateur -->
    <div class="split2 confwrap">
      <div class="panel tick conf reveal">
        <div class="cap mono"><span>Composez votre gestion sur mesure</span><b>SAO</b></div>
        <p class="conf-intro">Cochez ce que vous souhaitez nous confier — nous chiffrons le périmètre exact.</p>
        <fieldset class="opts">
          <legend class="sr-only">Prestations à inclure dans votre gestion</legend>
          {options.map((o) => (
            <label class="opt">
              <input type="checkbox" value={o.label} checked={o.socle} disabled={o.socle} data-socle={o.socle ? '1' : '0'} />
              <span>{o.label}{o.socle && <em class="mono"> · socle</em>}</span>
            </label>
          ))}
        </fieldset>
        <div class="conf-out">
          <span class="mono">Votre périmètre</span>
          <strong id="confCount">2 prestations</strong>
        </div>
        <a class="btn btn-gold conf-cta" id="confCta" href="#devis">Chiffrer ce périmètre</a>
      </div>

      <div class="panel tick conf reveal">
        <div class="cap mono"><span>Estimer mon loyer</span><b>SAO</b></div>
        <p class="conf-intro">Décrivez votre bien : un conseiller vous transmet une estimation argumentée sous 24 h ouvrées.</p>
        <div class="row2">
          <div class="field">
            <label for="estType">Type de bien</label>
            <select id="estType"><option>Appartement</option><option>Maison / villa</option><option>Studio</option><option>Local commercial</option><option>Terrain</option></select>
          </div>
          <div class="field">
            <label for="estPieces">Nombre de pièces</label>
            <select id="estPieces"><option>1</option><option>2</option><option>3</option><option>4</option><option>5 et plus</option></select>
          </div>
        </div>
        <div class="row2">
          <div class="field">
            <label for="estZone">Quartier / ville</label>
            <input id="estZone" type="text" placeholder="Keur Massar, Almadies…" />
          </div>
          <div class="field">
            <label for="estStanding">Standing</label>
            <select id="estStanding"><option>Standard</option><option>Confort</option><option>Haut standing</option></select>
          </div>
        </div>
        <a class="btn btn-gold conf-cta" id="estCta" href="#devis">Estimer mon loyer gratuitement</a>
        <p class="est-note mono">Estimation réalisée par un conseiller — aucune valeur automatique affichée.</p>
      </div>
    </div>

    <!-- Parcours en 5 étapes -->
    <h3 class="parcours-h">Confier votre bien, en 5 étapes.</h3>
    <ol class="parcours reveal">
      {parcours.map((p) => (
        <li class="panel tick pstep">
          <span class="vdot" aria-hidden="true">{p.n}</span>
          <b>{p.titre}</b>
          <span class="pd">{p.desc}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  /* Configurateur : compte les prestations retenues et pré-remplit le devis */
  const conf = document.querySelectorAll<HTMLInputElement>('.opts input[type="checkbox"]');
  const out = document.getElementById('confCount');
  const confCta = document.getElementById('confCta');

  const choisies = () =>
    Array.from(conf).filter((c) => c.checked).map((c) => c.value);

  function majConf() {
    const n = choisies().length;
    if (out) out.textContent = n + (n > 1 ? ' prestations' : ' prestation');
  }
  conf.forEach((c) => c.addEventListener('change', majConf));
  majConf();

  /* Reporte les choix dans le formulaire de devis */
  function versDevis(texte: string, besoin: string) {
    const type = document.querySelector<HTMLSelectElement>('#btpForm select[name="type"]');
    const msg = document.querySelector<HTMLTextAreaElement>('#btpForm textarea[name="message"]');
    if (type) {
      const opt = Array.from(type.options).find((o) => o.value === besoin);
      if (opt) type.value = besoin;
    }
    if (msg) msg.value = texte + (msg.value ? '\n\n' + msg.value : '');
  }

  confCta?.addEventListener('click', () => {
    versDevis('Gestion locative sur mesure — prestations souhaitées :\n· ' + choisies().join('\n· '), 'Gestion locative');
  });

  const estCta = document.getElementById('estCta');
  estCta?.addEventListener('click', () => {
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';
    versDevis(
      `Demande d'estimation de loyer :\n· Type : ${v('estType')}\n· Pièces : ${v('estPieces')}\n· Quartier : ${v('estZone') || 'à préciser'}\n· Standing : ${v('estStanding')}`,
      'Gestion locative',
    );
  });
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .formules { margin-bottom: 22px; align-items: stretch; }
  .fml { display: flex; flex-direction: column; position: relative; }
  .fml.pop { border-color: rgb(233 199 53 / 0.45); }
  .pop-tag {
    position: absolute; top: -11px; left: 24px; background: var(--gold); color: #171400;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px;
  }
  .fml h3 { font-size: 22px; font-weight: 800; }
  .fml .acc { color: var(--aqua2); font-size: 14px; margin: 6px 0 0; }
  .fml .prix {
    font-size: 13px; color: var(--gold); letter-spacing: 0.1em; text-transform: uppercase;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 12px 0; margin: 16px 0 18px;
  }
  .fml .checklist { margin-bottom: 22px; }
  .fml .checklist li { font-size: 14px; }
  .fml-cta { margin-top: auto; justify-content: center; }

  .tablewrap { padding: 0; overflow: hidden; margin-bottom: 22px; }
  .tw-head {
    font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--aqua2);
    padding: 16px 22px; border-bottom: 1px solid var(--line);
  }
  .tscroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 520px; }
  thead th {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--gold); text-align: center; padding: 14px 12px; border-bottom: 1px solid var(--line);
  }
  thead th:first-child { text-align: left; }
  tbody th {
    font-weight: 400; text-align: left; color: var(--mist); padding: 12px 16px;
    border-bottom: 1px solid var(--line2);
  }
  tbody td { text-align: center; padding: 12px; border-bottom: 1px solid var(--line2); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .yes { width: 18px; height: 18px; stroke: var(--gold); fill: none; stroke-width: 2.4; }
  .no { color: var(--gray); }

  .confwrap { align-items: stretch; gap: 22px; }
  .conf { padding: 26px; display: flex; flex-direction: column; }
  .conf .cap {
    display: flex; justify-content: space-between; align-items: center; font-size: 10.5px;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--aqua2);
    border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 16px;
  }
  .conf .cap b { color: var(--gold); }
  .conf-intro { color: var(--muted); font-size: 14.5px; }
  .opts { border: 0; padding: 0; margin: 6px 0 0; display: grid; gap: 9px; }
  .opt { display: flex; gap: 11px; align-items: center; font-size: 14.5px; cursor: pointer; min-height: 40px; }
  .opt input { width: 18px; height: 18px; accent-color: var(--gold); flex: none; cursor: pointer; }
  .opt input:disabled { opacity: 0.55; cursor: default; }
  .opt em { font-style: normal; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray); }
  .conf-out {
    display: flex; justify-content: space-between; align-items: center; margin: 20px 0 16px;
    padding-top: 16px; border-top: 1px solid var(--line);
  }
  .conf-out span { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); }
  .conf-out strong { font-family: var(--display); font-size: 18px; color: var(--gold); }
  .conf-cta { margin-top: auto; justify-content: center; }
  .est-note { font-size: 10.5px; color: var(--gray); margin: 12px 0 0; text-align: center; }

  .parcours-h { font-size: clamp(20px, 2.6vw, 26px); font-weight: 800; margin: 54px 0 20px; }
  .parcours { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .pstep { padding: 22px 18px; }
  .pstep .vdot { margin-bottom: 12px; }
  .pstep b { font-family: var(--display); font-size: 14.5px; display: block; margin-bottom: 6px; }
  .pstep .pd { color: var(--muted); font-size: 13px; }

  @media (max-width: 1024px) { .parcours { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 960px) { .confwrap { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .parcours { grid-template-columns: 1fr; } }
</style>
